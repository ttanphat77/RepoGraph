# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

# Secrets — bắt buộc phải set
GEMINI_API_KEY=your_gemini_api_key_here

# Credentials Neo4j — chỉ set nếu khác default trong config.py
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=graphrag123

# GitLab Triage Bot — bắt buộc nếu chạy bot/server.py
# GITLAB_WEBHOOK_SECRET=
# GITLAB_BOT_PAT=
# GITLAB_BOT_USER_ID=
# GITLAB_API_URL=https://gitlab.com/api/v4
